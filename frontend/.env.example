# Used by `bun --bun run dev` (and `bun run build` outside compose) to point
# the SvelteKit server at the FastAPI backend. In compose the frontend service
# receives BACKEND_PREFIX from compose.yaml, so this file is only used for
# local development.
#
# When developing locally against a running compose stack, point this at the
# host port the backend is exposed on (e.g. http://localhost:8000 if you have
# re-added `ports: ["8000:8000"]` to the backend service in compose.yaml).
BACKEND_PREFIX=http://localhost:8000
