# Backend env vars. Copy this file to `.env` at the repo root and fill in real values.
# `.env` is gitignored.

# When running with `docker compose up`, compose sets DATABASE_URL and VALKEY_URL
# to the in-network service hostnames (`db`, `valkey`). When running the backend
# outside compose (e.g. `python run.py` against an already-running compose stack),
# point these at localhost.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
VALKEY_URL=redis://localhost:6379/0

# Auth seed — used by both compose and the app's lifespan. If unset, the app
# starts with an empty `app_user` table and the seed logs "skipped".
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# Optional auth tuning. Uncomment to override the defaults shown.
# AUTH_TOKEN_TTL_SECONDS=86400
# AUTH_BCRYPT_ROUNDS=12

# OpenAI-compatible chat completions endpoint (used by the public /api/chat and
# /public/ai-chat routes). The backend default is http://localhost:1234/v1,
# which works for host dev but NOT inside a compose container. Pick the value
# for your environment:
#   - Docker Desktop (Mac/Windows): http://host.docker.internal:1234/v1
#   - Linux Docker bridge:         http://172.20.0.1:1234/v1   <-- default below
#   - Same-network LLM service:    http://llm:1234/v1
LLM_BASE_URL=http://172.20.0.1:1234/v1
LLM_API_KEY=not-needed
# Must match the model loaded in llama.cpp (check `GET /v1/models`); an
# unknown model name causes a 404 from llama.cpp even when the URL is right.
LLM_MODEL=unsloth/gemma-4-12b-it-GGUF:UD-Q4_K_XL
LLM_TIMEOUT_SECONDS=60
